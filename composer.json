{
    "name": "slash197/etransport",
    "description": "PHP client, message builder and local validator for ANAF's RO e-Transport system",
    "type": "library",
    "license": "MIT",
    "keywords": ["etransport", "e-transport", "ro-e-transport", "anaf", "uit", "schematron", "romania"],
    "homepage": "https://github.com/slash197/etransport",
    "authors": [
        {
            "name": "Levi Szocs",
            "email": "levi.szocs@codescape.ro"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "nyholm/psr7": "^1.8",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.9",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "guzzlehttp/guzzle": "Any PSR-18 HTTP client works; Guzzle is the one this package is tested with"
    },
    "autoload": {
        "psr-4": {
            "slash197\\eTransport\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "slash197\\eTransport\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
